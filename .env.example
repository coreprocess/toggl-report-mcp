# Toggl Track API token (from https://track.toggl.com/profile).
# TOGGL_API_TOKEN and TOGGL_TOKEN are accepted as aliases.
TOGGL_API_KEY=your_api_token_here

# Absolute path to the directory where report exports are written.
# Created on startup if missing. Relative paths are rejected.
TOGGL_EXPORT_DIR=/absolute/path/to/exports

# Optional: default workspace ID used when a tool call omits workspace_id.
#TOGGL_DEFAULT_WORKSPACE_ID=123456

# Optional: override the Toggl API base URL (testing/mocking only).
# Must be HTTPS unless pointing at a loopback address.
#TOGGL_API_BASE_URL=https://api.track.toggl.com

# Optional: per-attempt HTTP request timeout in milliseconds (default 60000).
#TOGGL_REQUEST_TIMEOUT_MS=60000
