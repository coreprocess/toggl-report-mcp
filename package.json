{
  "name": "toggl-report-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Stdio MCP server for the Toggl Reports API v3 with local file exports",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "toggl",
    "toggl-track",
    "reports",
    "time-tracking"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coreprocess/toggl-report-mcp.git"
  },
  "homepage": "https://github.com/coreprocess/toggl-report-mcp#readme",
  "bugs": {
    "url": "https://github.com/coreprocess/toggl-report-mcp/issues"
  },
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "toggl-report-mcp": "dist/main.js"
  },
  "imports": {
    "#*": "./src/*.contract.ts"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "test": "vitest run",
    "knip": "knip --production"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^26.1.1",
    "knip": "^6.29.0",
    "tsdown": "^0.22.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
